# Gateway
HTTP_ADDR=:8080
MODEL_PROVIDER=mock
REQUEST_TIMEOUT=30s

# DeepSeek provider (used when MODEL_PROVIDER=deepseek)
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=

# Generic OpenAI-compatible provider
# Used when MODEL_PROVIDER=openai-compatible.
OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

# PostgreSQL
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Redis
REDIS_ADDR=
REDIS_PASSWORD=
