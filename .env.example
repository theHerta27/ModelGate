# Gateway
HTTP_ADDR=:8080
# Host ports used by compose.yaml.
MODELGATE_PORT=8080
REDIS_PORT=6379
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
# Backward-compatible single-provider setting.
MODEL_PROVIDER=mock
# Optional static provider list: name:type:weight. When non-empty, this takes precedence.
# MODEL_PROVIDERS=primary:mock:2,backup:mock:1
MODEL_PROVIDERS=
ROUTING_STRATEGY=round_robin
REQUEST_TIMEOUT=30s
LOG_LEVEL=info

# Provider governance
UPSTREAM_ATTEMPT_TIMEOUT=10s
UPSTREAM_MAX_ATTEMPTS=3
RETRY_BASE_BACKOFF=100ms
RETRY_MAX_BACKOFF=2s
CIRCUIT_BREAKER_WINDOW_SIZE=20
CIRCUIT_BREAKER_MINIMUM_REQUESTS=10
CIRCUIT_BREAKER_FAILURE_RATIO=0.5
CIRCUIT_BREAKER_OPEN_TIMEOUT=30s
CIRCUIT_BREAKER_HALF_OPEN_MAX_REQUESTS=1
PROVIDER_MAX_CONCURRENCY=50

# DeepSeek provider (used when MODEL_PROVIDER=deepseek)
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=

# Generic OpenAI-compatible provider
# Used when MODEL_PROVIDER=openai-compatible.
OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

# Redis policies (rate limit, idempotency, and response cache)
REDIS_ENABLED=false
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TIMEOUT=2s
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=60
RATE_LIMIT_FAIL_OPEN=true
IDEMPOTENCY_TTL=24h
IDEMPOTENCY_LOCK_TTL=30s
CACHE_TTL=5m

# PostgreSQL usage persistence
# POSTGRES_DSN takes precedence over the individual fields when non-empty.
POSTGRES_ENABLED=false
POSTGRES_DSN=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_SSLMODE=disable
POSTGRES_MAX_CONNS=10
STORAGE_TIMEOUT=2s

# Grafana local-development account used by compose.yaml.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
