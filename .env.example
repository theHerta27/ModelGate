# Gateway
HTTP_ADDR=:8080
MODEL_PROVIDER=mock
REQUEST_TIMEOUT=30s

# DeepSeek provider (used when MODEL_PROVIDER=deepseek)
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=

# Generic OpenAI-compatible provider
# Used when MODEL_PROVIDER=openai-compatible.
OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

# Redis policies (rate limit, idempotency, and response cache)
REDIS_ENABLED=false
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TIMEOUT=2s
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=60
RATE_LIMIT_FAIL_OPEN=true
IDEMPOTENCY_TTL=24h
IDEMPOTENCY_LOCK_TTL=30s
CACHE_TTL=5m

# PostgreSQL usage persistence
# POSTGRES_DSN takes precedence over the individual fields when non-empty.
POSTGRES_ENABLED=false
POSTGRES_DSN=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_SSLMODE=disable
POSTGRES_MAX_CONNS=10
STORAGE_TIMEOUT=2s
